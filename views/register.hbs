{{!-- Registration form for new in-memory users. --}}
<div class="bg-clear">
    <div class="log-reg">
        <h2>Cookie authentication</h2>
        <br>
        <form method="post">
            <input type="text" placeholder="Login" class="l_inp" name="login" id="login" required>
            <br>
            <input type="password" name="pass" id="pass" placeholder="Password" class="l_inp" required>
            <input type="password" name="c_pass" id="c_pass" placeholder="Confirm password" class="l_inp" required>
            <input type="submit" value="Register" class="l_inp">
        </form>
        <br>
        Masz już konto? <a href="/login">Zaloguj się</a>
    </div>
</div>