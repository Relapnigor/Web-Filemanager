{{!-- Login form for existing users. --}}
<div class="bg-clear">
    <div class="log-reg">
        <h2>Cookie authentication</h2>
        <br>
        <form method="post">
            <input type="text" placeholder="Login" class="l_inp" name="login">
            <br>
            <input type="password" name="pass" id="pass" placeholder="Password" class="l_inp">
            <input type="submit" value="LogIn" class="l_inp">
        </form>
        <br>
        Nie masz konta? <a href="/register">Zarejestruj się</a>
    </div>
</div>