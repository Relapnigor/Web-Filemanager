{{!-- Shows metadata for the currently selected file. --}}
<div class="place">
    file info
</div>

<div class="info">
    <p>Id: <span>{{id}}</span></p>
    <p>Name: <span>{{name}}</span></p>
    <p>Path: <span>{{path}}</span></p>
    <p>Size: <span>{{size}}</span></p>
    <p>Type: <span>{{type}}</span></p>
    <p>Savedate: <span>{{savedate}}</span></p>
</div>